{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenQuire",
  "version": "0.6.0",
  "identifier": "dev.akilfernando.openquire",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OpenQuire",
        "width": 1320,
        "height": 880,
        "minWidth": 720,
        "minHeight": 520,
        "dragDropEnabled": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "category": "Productivity",
    "shortDescription": "Open source PDF suite",
    "longDescription": "Edit, annotate, sign, redact, fill, organize, compare and convert PDFs, entirely on your computer.",
    "license": "AGPL-3.0-or-later",
    "publisher": "OpenQuire",
    "homepage": "https://akilfernando.dev/openquire/",
    "fileAssociations": [
      { "ext": ["pdf"], "mimeType": "application/pdf", "description": "PDF document", "role": "Editor" }
    ]
  }
}
